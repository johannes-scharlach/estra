# Copy to .env.local and fill in. EXPO_PUBLIC_* vars are inlined into the
# JS bundle at build time — never put a service-role key here.

# Which backend to point at: local | dev | prod
APP_ENV=local

# --- local: `supabase start` + `docker compose up` -------------------------
# A simulator can use localhost. A physical device cannot — use your
# Tailscale hostname (`tailscale ip -4`) or LAN IP so the phone can reach
# this machine, and keep it in sync with supabase/config.toml site_url.
EXPO_PUBLIC_SUPABASE_URL=http://localhost:55321
EXPO_PUBLIC_POWERSYNC_URL=http://localhost:8080

# Chat API and invite landing pages (`pnpm api`, apps/api on port 8787). Same rule: localhost for a
# simulator, Tailscale/LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Printed by `supabase start`. Publishable/anon key, safe to ship.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- dev / prod ------------------------------------------------------------
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_POWERSYNC_URL=https://<instance>.powersync.journeyapps.com
# EXPO_PUBLIC_API_URL=https://estra-api.fly.dev
