{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --sourcemap --outfile=dist/index.cjs",
    "start": "node --enable-source-maps dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@estra/profile": "workspace:*",
    "@ai-sdk/google": "^4.0.47",
    "@hono/node-server": "^2.1.1",
    "ai": "^7.0.70",
    "hono": "^4.13.3",
    "jose": "^6.2.9",
    "pg": "^8.23.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
